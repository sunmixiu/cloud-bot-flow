  "sources": [
    {
      "id": 101,
      "catalog_key": "slam-toolbox",
      "name": "SLAM Toolbox 2D 建图",
      "module": "定位与建图",
      "language": "C++ / ROS 2",
      "version": "ros2@eee0cd5",
      "author": "Steve Macenski / Open Navigation",
      "repository_url": "https://github.com/SteveMacenski/slam_toolbox",
      "branch": "ros2",
      "verified_commit": "eee0cd5e4a161bb10f8334b5420c93876b31ca99",
      "license": "LGPL-2.1",
      "description": "ROS 2 的二维建图、定位、回环检测与终身地图维护工具。",
      "simulation": {
        "image": "catalog.local/ros2/slam-toolbox:eee0cd5",
        "command": "ros2 launch slam_toolbox online_async_launch.py",
        "runtime": "ROS 2",
        "inputs": ["/scan", "/tf"],
        "outputs": ["/map", "/pose", "/tf"],
        "input_types": {
          "/scan": "sensor_msgs/msg/LaserScan",
          "/tf": "tf2_msgs/msg/TFMessage"
        },
        "output_types": {
          "/map": "nav_msgs/msg/OccupancyGrid",
          "/pose": "geometry_msgs/msg/PoseWithCovarianceStamped"
        },
        "color": "#3b82f6"
      }
    },
    {
      "id": 102,
      "catalog_key": "navigation2",
      "name": "Nav2 自主导航",
      "module": "导航与路径规划",
      "language": "C++ / ROS 2",
      "version": "main@193ae1f",
      "author": "Open Navigation",
      "repository_url": "https://github.com/ros-navigation/navigation2",
      "branch": "main",
      "verified_commit": "193ae1f95c62d4c782e09fa40beffa259f81ab92",
      "license": "多许可证（Apache-2.0 / BSD-3-Clause / LGPL-2.1+）",
      "description": "ROS 2 自主导航框架，包含规划、控制、行为树、代价地图与安全监控。",
      "simulation": {
        "image": "catalog.local/ros2/navigation2:193ae1f",
        "command": "ros2 launch nav2_bringup navigation_launch.py",
        "runtime": "ROS 2",
        "inputs": ["/map", "/odom", "/goal_pose"],
        "outputs": ["/cmd_vel", "/plan", "/navigation_feedback"],
        "input_types": {
          "/map": "nav_msgs/msg/OccupancyGrid",
          "/odom": "nav_msgs/msg/Odometry",
          "/goal_pose": "geometry_msgs/msg/PoseStamped"
        },
        "output_types": {
          "/cmd_vel": "geometry_msgs/msg/Twist",
          "/plan": "nav_msgs/msg/Path"
        },
        "color": "#06b6d4"
      }
    },
    {
      "id": 103,
      "catalog_key": "apriltag-ros2",
      "name": "AprilTag ROS 2 视觉定位",
      "module": "机器视觉",
