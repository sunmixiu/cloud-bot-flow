# 留空时使用仓库内的轻量后端。
VITE_API_BASE_URL=
VITE_DEPLOY_API_BASE_URL=
VITE_MQTT_URL=

# 可选：接入真实的监控、训练、3D 查看器和机器人模型图片服务。
VITE_MONITORING_URL=
VITE_TRAINING_URL=
VITE_ROBOT_VIEWER_URL=
VITE_BRAIN_ASSEMBLY_URL=
VITE_ROBOT_IMAGE_URL=

# 后端：留空时使用本地 Cube Studio 兼容执行器。
CUBE_STUDIO_BASE_URL=
CUBE_STUDIO_TOKEN=
CUBE_STUDIO_PROJECT_ID=1
CUBE_STUDIO_HEALTH_PATH=/health
CUBE_STUDIO_TIMEOUT_MS=8000

# 后端：配置后将 Pipeline 产物写入 MinIO；留空则写入 backend/artifacts。
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=minio123
MINIO_BUCKET=mlpipeline
MINIO_REGION=us-east-1
MINIO_STRICT=false
